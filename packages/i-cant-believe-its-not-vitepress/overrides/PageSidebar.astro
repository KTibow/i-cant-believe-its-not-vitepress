---
/*
 * The "On this page" rail, styled as VitePress's document outline: a hairline
 * running down the left of the list, with a brand-coloured marker parked on it
 * beside the heading you are currently reading. The marker is pure CSS —
 * Starlight's table of contents already tracks the active heading and sets
 * `aria-current`, so no second script is needed to move it.
 */
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
---

{
	Astro.locals.starlightRoute.toc && (
		<>
			<div class="lg:sl-hidden">
				<MobileTableOfContents />
			</div>
			<div class="right-sidebar-panel sl-hidden lg:sl-block">
				<TableOfContents />
			</div>
		</>
	)
}

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding-block: 2rem;
			font-size: 0.8125rem;
			font-weight: 500;
		}

		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: 0.875rem;
			font-weight: 600;
			line-height: 2.2857143;
		}

		/* The hairline the marker rides on. */
		.right-sidebar-panel :global(nav > ul) {
			position: relative;
			border-inline-start: 1px solid var(--sl-color-hairline);
			padding-inline-start: 1rem;
		}

		.right-sidebar-panel :global(:where(a)) {
			/* Zero out the list's own inline padding so the text meets the hairline. */
			--pad-inline: 0rem;
			position: relative;
			display: block;
			padding-block: 0;
			line-height: 2.2857143;
			color: var(--sl-color-gray-3);
			text-decoration: none;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		.right-sidebar-panel :global(a[aria-current='true']) {
			color: var(--sl-color-white);
		}

		/*
		 * Every link starts at the same inline offset — the nesting indent is padding
		 * inside the link, not margin on the list — so one offset parks the marker on
		 * the hairline at any depth.
		 */
		.right-sidebar-panel :global(a[aria-current='true'])::before {
			content: '';
			position: absolute;
			inset-block: 0.375rem;
			inset-inline-start: calc(-1rem - 1px);
			width: 2px;
			border-radius: 2px;
			background-color: var(--sl-color-text-accent);
		}
	}
</style>
